{
  "id": "./",
  "name": "Yume. Writing",
  "short_name": "Yume. Writing",
  "description": "Ghi chú thông minh Yume Writing",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f3f2",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "application/pdf",
            ".pdf",
            ".doc",
            "application/msword",
            ".docx",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".txt",
            "text/plain",
            ".md",
            "text/markdown",
            ".csv",
            "text/csv",
            ".json",
            "application/json",
            ".html",
            "text/html"
          ]
        }
      ]
    }
  }
}